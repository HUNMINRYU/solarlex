[Unit]
Description=SolarLex Seoul ordinance Q&A API
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/solarlex/engine
EnvironmentFile=/home/ubuntu/solarlex/engine/.env
ExecStart=/home/ubuntu/solarlex/engine/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8010 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
